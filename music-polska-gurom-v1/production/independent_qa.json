  "source_findings": [
    {
      "severity": "minor",
      "location": "compose.py lp() plus render() stereo echo",
      "finding": "lp calls scipy.signal.sosfilt with default axis=-1. The stereo echo source is N x 2, so its low-pass filter runs across the two stereo channels, not through time. This reduces and changes the stereo echo instead of applying its intended 4300 Hz temporal low-pass. Dry instruments and room reverb use mono arrays and are unaffected.",
      "suggestion": "Pass axis=0 in lp() to handle mono and stereo audio consistently."
    },
    {
      "severity": "minor",
      "location": "compose.py save_midi()",
      "finding": "BASE dulcimer MIDI has overlapping repeated note 74 at beats 114/114.5 and duplicate note 81 onset at beat 123, followed by redundant note-offs. Some MIDI players may shorten the repeated note. This is not evidence of a fault in synthesized WAV.",
      "suggestion": "Merge overlapping intervals for identical track/note before MIDI serialization, retaining maximum velocity and latest note-off."
    }
  ],
